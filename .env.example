# Firebase is the normal runtime. No local database is used.
PORT=3000
NODE_ENV=development
DB_CLIENT=firebase

# Firebase Console > Project settings > General > Your apps > Web app.
# These are public web configuration values, not administrator credentials.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_APP_ID=your-web-app-id
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Server credentials: choose ONE method, never put these in public/ or chat.
# Local: save the downloaded service-account JSON outside public/, and set its path.
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/firebase-service-account.json
# Hosting: set the entire JSON as a private environment secret instead.
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}

# Only used by the read-only migration command, not by the application runtime.
# LEGACY_SQLITE_PATH=C:/path/to/existing/ecommerce.sqlite

# Future payment integration only. Online payments are not connected.
# RAZORPAY_KEY_ID=rzp_test_placeholder
# RAZORPAY_KEY_SECRET=server_only_placeholder
# RAZORPAY_WEBHOOK_SECRET=server_only_placeholder
