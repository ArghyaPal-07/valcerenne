{
  "name": "valcerenne-ecommerce",
  "version": "1.0.0",
  "description": "Valcerenne \u2014 a considered multi-category shopping experience",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "seed": "node scripts/migrate-firebase.cjs",
    "test": "npm run test:firebase",
    "test:browser": "node scripts/test-browser.cjs",
    "check": "node scripts/check-syntax.cjs",
    "build": "node scripts/build-firebase.cjs",
    "seed:legacy": "node database/init-db.js",
    "migrate:firebase": "node scripts/migrate-firebase.cjs",
    "test:legacy": "node server/test-api.js && node server/test-commerce.js",
    "test:firebase": "firebase emulators:exec --only firestore,auth --project demo-valcerenne \"node server/test-firebase.js\"",
    "firebase:admin": "node scripts/firebase-admin.cjs",
    "firebase:check": "node scripts/check-firebase.cjs",
    "firebase:rules": "node scripts/deploy-firebase-rules.cjs"
  },
  "engines": {
    "node": "22.x"
  },
  "keywords": [
    "ecommerce",
    "nodejs",
    "express",
    "sqlite",
    "mysql",
    "fullstack"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "12.0.0",
    "firebase-admin": "13.4.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "firebase-tools": "14.12.1",
    "nodemon": "^3.1.9",
    "playwright": "^1.64.1"
  },
  "overrides": {
    "@firebase/app": "0.14.0",
    "@firebase/app-compat": "0.5.0",
    "firebase-admin": {
      "@firebase/database-compat": "2.0.10"
    }
  }
}
